# Copy to .env. Read twice: by `node --env-file-if-exists` for the app, and by Docker
# Compose for the two services, which is why the passwords appear here as values rather
# than only inside the connection strings.

# ---------------------------------------------------------------- the database container
#
# Generate three, once, and never reuse them anywhere else:
#   node -e "console.log(require('crypto').randomBytes(21).toString('base64url'))"
#
# Keep them alphanumeric: setup/docker-init.sh seds them into setup/00-roles.sql on the
# first boot of a fresh volume, and a `/` or a quote would break it. They are only applied
# to a NEW volume: changing them later means `docker compose down -v`, which deletes the
# data, or an ALTER ROLE by hand.

POSTGRES_SUPERUSER_PASSWORD=CHANGE-ME-SUPER
ARLO_OWNER_PASSWORD=CHANGE-ME-OWNER
ARLO_APP_PASSWORD=CHANGE-ME-APP

# ---------------------------------------------------------------- database
#
# Two roles, and the split between them is the security model. The app connects as the
# NOBYPASSRLS one, so a query that forgets to open a workspace scope reads zero rows
# instead of another tenant's knowledge base. See setup/00-roles.sql.
#
# These two are for running the app OUTSIDE the container: `npm run dev` and `npm test`
# against `docker compose up -d db`. The app service builds its own from the passwords
# above, pointed at `db:5432` on the compose network. Passwords must match.

DATABASE_URL=postgresql://arlo_app:CHANGE-ME-APP@127.0.0.1:54322/arlo
# The owner. Runs migrations and asSystem() only: never the request path.
DATABASE_URL_OWNER=postgresql://arlo_owner:CHANGE-ME-OWNER@127.0.0.1:54322/arlo
# Path to the server's CA certificate, or the PEM itself. Required in production: without
# it the connection refuses to guess and runs unverified only on loopback.
DATABASE_CA_CERT=
# Max pooled connections per role. Default 10.
DATABASE_POOL=
# Which schema the tables live in. `arlo` is what setup/00-roles.sql creates and what the
# app service uses; the tests override it per file.
DATABASE_SCHEMA=arlo

# ---------------------------------------------------------------- sign-in
#
# One account, kept in this database, and nothing to configure here. The first sign-in
# creates it along with the one workspace: username `arlo`, password `arlo`, changed in
# Settings. There is no identity provider and no registration.
#
# ⚠ THE DEFAULT PASSWORD IS PUBLISHED IN THE README, so until it is changed the sign-in is
# a formality: anyone who reaches the port is fully inside, with the knowledge base, every
# customer conversation and every connected channel one request away. That is safe exactly
# as long as the port stays on loopback, which is how docker-compose.yml publishes it.
# Putting this on a network or a public address means changing the password first, and is
# better done behind something that authenticates in its own right.
#
# The tenant boundary itself is untouched: row-level security still governs every table
# under DATABASE_URL as `arlo_app` (NOBYPASSRLS) above, and test/rls.test.js still proves
# it. Pointing DATABASE_URL at a privileged role would void every policy in migrations/.
# That is still the single worst change that can be made to this codebase.

# ---------------------------------------------------------------- the model
#
# Autobricks, and only Autobricks. Every answer, tool call and extraction goes out on this
# key and bills to that account. Another provider is a deliberate fork: change ENDPOINT and
# modelFor in src/server/llm.ts, which is the whole of it.
#
# Optional here, because Settings can save a key later and writes it back to this file. With
# none at all the app runs and every question goes to a person, unanswered rather than
# invented.

AUTOBRICKS_API_KEY=
# What a bot that chooses nothing runs on. Budget tier, so a new account with no credit
# still answers.
AUTOBRICKS_MODEL=autobricksai/gpt-4.1-mini

# ---------------------------------------------------------------- embeddings
#
# The one call configured here rather than in Settings, which makes it the one place another
# provider can be pointed at: anything OpenAI-shaped works. Autobricks serves /v1/embeddings,
# so the ordinary setup is the same key again, on the URL below.
#
# Leave all three blank and nothing breaks: retrieval falls back to Postgres full-text
# search, which is tested and works. Semantic search is what is missing, not the product.
# Set a key later and everything already stored is embedded in the background.
#
# The model has to be 1536 wide, because that is the vector(n) in migrations/001_schema.sql.
# text-embedding-3-small is, natively. Changing the width means a migration and re-embedding
# everything, so it is not a runtime knob: leave DIMS blank unless a provider needs telling.
#
#   EMBEDDINGS_URL=https://api.autobricksai.com/v1/embeddings
#   EMBEDDINGS_MODEL=autobricksai/text-embedding-3-small
EMBEDDINGS_URL=
EMBEDDINGS_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMS=

# Lets a chatbot granted the "search the web" tool actually use it. Without this the tool
# is still grantable, and tells the model plainly that it is unconfigured rather than
# returning nothing and letting it conclude the answer is no.
#   https://brave.com/search/api/
BRAVE_SEARCH_KEY=

# ---------------------------------------------------------------- secrets

# Encrypts connector tokens and the model key at rest, with AES-256-GCM.
#
# Any text at all. It is put through SHA-256 to derive the actual 32-byte key, so length and
# character set do not matter: typing randomly on the keyboard is a valid way to fill this
# in. What matters is that it is hard to guess and that it never changes: rotate it and
# every secret already stored reads as absent, so mailboxes and bots stop working at once.
#
#   ./scripts/setup.sh    generates one, along with the three passwords above
SECRET_KEY=


# ---------------------------------------------------------------- ingest and channels

# Public base URL, used to build OAuth redirects and webhook addresses.
PUBLIC_URL=http://127.0.0.1:9005

# An escape hatch, not the gate. A user-supplied URL is a trust boundary, so the scraper
# resolves the address first and refuses anything private: the metadata endpoint, the
# database, the admin panel on the next port. Every PUBLIC address is allowed without this
# being set, because crawling your own website is the entire point of the feature.
#
# Name a host here only to say "this internal one is fine too". See src/server/net.ts.
SCRAPE_ALLOW_HOSTS=

# Where Baileys keeps WhatsApp credentials. One directory per linked number.
WA_AUTH_DIR=.wa-auth

# Shared OAuth apps for mailbox connectors. A workspace can bring its own instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Seconds between mailbox and reminder sweeps. 0 disables the timer entirely, and is also
# how a process says it does no background work at all: the Telegram poller reads it too.
POLL_SECONDS=60

# Receive Telegram by fetching rather than by webhook.
#
# A webhook is Telegram calling you, so it needs a hostname their servers can resolve over
# HTTPS. A laptop is not one, and neither is a container behind NAT: setWebhook answers
# "Failed to resolve host" and the bot cannot be added. Polling is the other direction and
# needs no inbound connectivity at all.
#
# Leave it unset anywhere PUBLIC_URL is a real public address: a webhook costs nothing while
# idle, and this is tried first and fallen back from automatically. Set it where the answer
# is already known, to skip an attempt that cannot succeed.
TELEGRAM_POLLING=

# ---------------------------------------------------------------- production
# Only server/prod.mjs reads these.
PORT=9005
HOST=127.0.0.1
WEB_WORKERS=

# Reading scanned PDFs.
#
# A scan has no text in it, so the only way in is to look at the pixels. Tesseract does
# that locally: nothing leaves the machine and there is no per-page cost, which matters
# when the document is somebody internal handbook. It costs a few seconds a page and
# downloads about 15MB of language data the first time it runs.
#
# Blank switches it off, and a PDF that has a real text layer is always read from that
# instead: this is only ever the fallback.
OCR_LANGS=eng
# Two languages in one workspace: OCR_LANGS=eng+chi_sim
OCR_MAX_PAGES=60
# OCR_CACHE_DIR=node_modules/.cache/tesseract
